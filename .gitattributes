# Normalize text line endings across platforms.
* text=auto
*.md text eol=lf
*.ps1 text eol=lf
*.json text eol=lf
*.java text eol=lf
*.xml text eol=lf
*.sql text eol=lf
.gitignore text eol=lf
.gitattributes text eol=lf

# Office documents and images must remain byte-for-byte binary files.
*.docx binary
*.pdf binary
*.png binary
*.jpg binary
*.jpeg binary
