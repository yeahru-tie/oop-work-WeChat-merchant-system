flowchart TD
    A["启动客户端"] --> B["输入账号 / 密码"]
    B --> C{"账号已存在 ?"}
    C -- 否（注册） --> D["二次确认密码 · 哈希加盐存储"]
    D --> E["服务端写入 t_user"]
    E --> F["返回注册成功"]
    F --> B
    C -- 是（登录） --> G["服务端查询 t_user · 校验密码哈希"]
    G --> H{"校验通过 ?"}
    H -- 否 --> I["返回错误码 · 提示重试"]
    I --> B
    H -- 是 --> J["返回会话与角色"]
    J --> K{"角色 ?"}
    K -- 顾客 --> L["挂载顾客界面"]
    K -- 店主 --> M["挂载店主界面"]
